# === Festiva AI — Environment Variables ===
# Copy to .env in backend/ and fill in values.

DATABASE_URL=postgresql://festiva:festiva_dev@localhost:5432/festiva
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider: fake | openai | gemini (only "fake" works in Phase 1)
LLM_PROVIDER=fake
LLM_API_KEY=
