# === Festiva AI — Environment Variables ===
# Copy to .env in backend/ and fill in values.

ENV=dev
DATABASE_URL=postgresql://festiva:festiva_dev@127.0.0.1:5432/festiva
TEST_DATABASE_URL=postgresql://festiva:festiva_dev@127.0.0.1:5432/festiva_test
REDIS_URL=redis://127.0.0.1:6379/0

# Auth / JWT (in non-dev environment, must be changed to a secure key >= 32 chars)
JWT_SECRET=change-me-to-a-random-secret-key-32b
SECRET_KEY=change-me-to-a-random-secret-key-32b
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider: groq | fake | openai | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

